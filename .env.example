# Copy to .env locally. Never commit real credentials.
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3-vl-flash
ASR_MODEL=qwen3-asr-flash
# Optional; when set, clients must send X-App-Access-Token on /api requests.
APP_ACCESS_TOKEN=
MODEL_TIMEOUT_SECONDS=25
RATE_LIMIT_PER_MINUTE=30
# Set to a trusted origin only when serving frontend separately; same-origin is preferred.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
